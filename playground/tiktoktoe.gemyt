ind gemyt, liste, linjer fra "gemyt";

stabil SPILLER = ["X", "O"]
stabil TOM = -1
stabil VINNER_IDX = [
  [0, 1, 2], [3, 4, 5], [6, 7, 8],
  [0, 3, 6], [1, 4, 7], [2, 5, 8],
  [0, 4, 8], [2, 4, 6]
];

stabil lav_tictactoe = gør(spillere) {
    hvis spillere.vægt != 2 {
        aflever øv("tictactoe er 1v1.")
    }

    stabil bord = liste.fyld(TOM, 9)

    lad spiller_idx = 0
    lad ryk = 0
    lad spil_ovre = nej
    lad fejl = niks

    aflever flot({
        "render": gør() {
            lad str = "[";
            str = "---------------- TIC TAC TOE ----------------\n\n"
            str += spillere[0] + "(X)"
            hvis spiller_idx == 0 {
                str += "*"
            }
            str += " VERSUS " + spillere[1] + "(O)"
            hvis spiller_idx == 1 {
                str += "*"
            }
            str += " \n\n\n["
            kør v, i af bord {
                hvis v == TOM {
                    str += " " + i
                } ellers {
                    str += " " + v;
                }
                hvis (i + 1) % 3 == 0 {
                    str += " ]"
                        hvis i < bord.vægt - 1 {
                            str += "\n["
                        }

                }
            }
            str += "\n\n"
            linjer.ryd();
            råb(str)
        },
        "placer": gør(idx) {
            hvis ryk >= bord.vægt {
                spil_ovre = ja
                råb("Ingen vinder fundet. Uafgjort!")
                aflever niks
            }
            hvis ikke (bord[idx] == TOM) {
                fejl = "Kvadrat " + idx +  " er allerede taget.\n"
                aflever niks
            }

            bord[idx] = SPILLER[spiller_idx]
            ryk += 1
            fejl = niks

            kør v af VINNER_IDX {
                hvis gemyt.type(bord[v[0]]) == "Tekst" og bord[v[0]] == bord[v[1]] og bord[v[0]] == bord[v[2]] {
                    spil_ovre = ja
                    råb(spillere[spiller_idx] + " vandt spillet! Tillykke.")
                    aflever niks
                }
            }

            spiller_idx = (spiller_idx + 1) % spillere.vægt
        },
        "fejl": gør() { fejl },
        "færdig": gør() { spil_ovre },
        "nuværende_spiller": gør() { spillere[spiller_idx] }
   })
}


gør() {
    stabil spillere = [linjer.spørgsmål("Hvad er dit navn? (maks 12)\n> ", 12)]

    prøv linjer.vælg("Hvem vil du spille mod?", ["Menneske", "AI"]) {
        "Menneske" => liste.skub(spillere, linjer.spørgsmål("Hvad er modstanders navn? (maks 12)\n> ", 12)),
        "AI" => liste.skub(spillere, "AI")
    }

    stabil spil = lav_tictactoe(spillere).afklæd();

    mens ikke spil.færdig() {
        spil.render();

        prøv gemyt.type(spil.fejl()) {
            "Tekst" => råb(spil.fejl())
        }

        spil.nuværende_spiller() + " vælg en kvadrat\n> " |> linjer.tal |> spil.placer

    }

    afslut(0)
}()


