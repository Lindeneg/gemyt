ind gemyt, stig, fil, json, liste, linjer, tekst fra "gemyt"
ind matematik, lav_tæller fra "./foo.gemyt"

stabil tæller = lav_tæller()

kør _ af række(3) {
    råb("op", tæller.op())
}

kør _ af række(10) {
    råb("ned", tæller.ned())
}

råb("kvadrat", matematik.kvadrat(tæller.værdi()))
råb("halv", matematik.halv(tæller.værdi()))

råb("pipe square half", tæller.værdi() |> matematik.kvadrat |> matematik.halv)

stabil master_fatman = ["lars", "yanis", "per", "john", "fedte", "ketil"]
råb(master_fatman, master_fatman.vægt)

stabil slim_shady = liste.slankekur(master_fatman, gør(x) { x.vægt > 4; })
råb(slim_shady, slim_shady.vægt)

kør v, i af master_fatman {
    råb("kør iter", i, v)
}

kør i af række(slim_shady.vægt) {
    råb("kør række", i, slim_shady[i])
}

lad i = 0
mens ja {
    hvis i > 3 {
        råb("stopper")
        stop
    }
    råb("mens " + i)
    i+=1
}

stabil root_path = stig.vej(".", "sample")
stabil sample_file = stig.vej(root_path, "sart.gemyt")

hvis fil.er_mappe(root_path) {
    råb(root_path + " findes allerede")
    afslut(1)
}

hvis fil.er_fil(sample_file) {
    råb(sample_file + " findes allerede")
    afslut(1)
}

prøv fil.opret_mappe(root_path) {
    flot(v) => råb("skrev mappe " + root_path),
    øv(v) => råb("skrev ikke mappe " + root_path)
}

fil.skriv(sample_file, "hej med dig").afklæd()

lad kilde = stram fil.læs(sample_file)

råb("kilde: " + kilde)

fil.udryd(root_path)

lad halløj = {"svensker": {"er": øv(0)}, "nordmand": {"er": flot(1).afklæd()}}

// TODO lav ordbog itererbar
//kør v, k af halløj {
//    råb(v, k)
//}

råb(halløj)
råb(halløj.svensker.er.erFint, halløj.svensker.er.værdi)
råb(halløj.nordmand.er)

stabil hejsa = json.til(halløj)

råb(hejsa)
råb(stram json.fra(hejsa))
råb(json.flot(hejsa))

kør v af tekst.split("hello", "") {
    råb("split: ", v)
}

råb("søg: ", tekst.søg("hello", "ll"))
råb("starter_med he: ", tekst.starter_med("hello", "he"))
råb("starter_med hee: ", tekst.starter_med("hello", "hee"))
råb("ender_med lo: ", tekst.ender_med("hello", "lo"))
råb("ender_med loo: ", tekst.ender_med("hello", "loo"))
råb("erstat llo med ool", tekst.erstat("hello", "llo", "ool"))
råb("grande", tekst.grande("hello"))
råb("bitte", tekst.bitte("HELLO"))

stabil svar = gør () {
    stabil navn = linjer.spørgsmål("Hvad er dit navn?\n> ", 12)
    råb("navn: ", navn)

    stabil alder = linjer.tal("Hvad er din alder?\n> ")
    råb("alder: ", alder, gemyt.type(alder))

    hvis alder < 18 {
        aflever øv("du er ikke gammel nok til at bruge denne app..")
    }

    stabil bekræft = linjer.bekræft("Er du sikker?\n> ")
    råb("bekræft: ", bekræft)

    hvis alder < 25 {
        aflever øv("nu stopper du altså med at lyve")
    }

    stabil valg = linjer.vælg("Hvem er bedst?", ["L10", "C7"])

    prøv valg {
        "L10" => råb("messi er nemlig bedst"),
        "C7" => råb("den falske ronaldo? hvad tænker du på menneske?"),
    }

    aflever flot(niks)
}()

råb(svar.værdi)

